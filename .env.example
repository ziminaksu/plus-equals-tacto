# Copy to .env. NEVER commit .env or paste API keys into chat.
ARENA_URL=https://arena.tacto.ai
ARENA_API_KEY=
ARENA_DATA=data/package

# OpenAI API (separate from ChatGPT subscriptions)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Hollerau agent uses BRAIN_MODEL independently of LLM_MODEL.
BRAIN_MODEL=gpt-4.1-mini
WRITER_MODEL=gpt-4.1-mini
SIM_MODEL=gpt-4.1-mini
# Optional alternative provider: leave unset to use OpenAI.
# QWEN_API_KEY=

# New analytical agent: Hugging Face Inference Providers
HF_TOKEN=
QWEN_SMALL_MODEL=Qwen/Qwen3.8-27B:deepinfra
QWEN_LARGE_MODEL=Qwen/Qwen3.8-2.4T-A95B:deepinfra

# Analytical agent: Astra negotiator plus a separate final decision-maker.
ANALYTICAL_PRIMARY=astra
STRATEGIC_REVIEWER=astra
OPENAI_API_KEY=
# Responses API, low reasoning, strict case-specific JSON schema, store=false.
# No silent Python fallback if Astra cannot authorize the final action.
# Explicit legacy comparison: ANALYTICAL_PRIMARY=qwen and LLM_PROVIDER=hf.
# STRATEGIC_REVIEWER=primary uses the legacy large model in that comparison.

# Decision model used by tools/run_azure.sh and tools/final_azure.sh (Live Final setup):
# gpt-5-mini on Azure OpenAI, Hugging Face and Gemini as automatic backups on 429/503/timeouts.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_KEY=
# Free Gemini (tools/run_free.sh, and backup in the Azure chain)
GEMINI_API_KEY=
