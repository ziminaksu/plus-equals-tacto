# Copy to .env. NEVER commit .env or paste API keys into chat.
ARENA_URL=https://arena.tacto.ai
ARENA_API_KEY=
ARENA_DATA=data/package

# OpenAI API (separate from ChatGPT subscriptions)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Hollerau agent uses BRAIN_MODEL independently of LLM_MODEL.
BRAIN_MODEL=gpt-4.1-mini
WRITER_MODEL=gpt-4.1-mini
SIM_MODEL=gpt-4.1-mini
# Optional alternative provider: leave unset to use OpenAI.
# QWEN_API_KEY=

# New analytical agent: Hugging Face Inference Providers
HF_TOKEN=
QWEN_SMALL_MODEL=Qwen/Qwen3.8-27B:deepinfra
QWEN_LARGE_MODEL=Qwen/Qwen3.8-2.4T-A95B:deepinfra

# Independent strategic reviewer for the analytical agent; Qwen routing above stays intact.
# Set LLM_PROVIDER=hf to use Qwen for routine interpretation.
STRATEGIC_REVIEWER=astra
OPENAI_API_KEY=
# Astra uses the OpenAI Responses API, medium reasoning, at most 4096 output/reasoning tokens.
# Set STRATEGIC_REVIEWER=primary to use the configured large model instead.
