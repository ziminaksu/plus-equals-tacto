  "recommended_sequence": [
    {
      "priority": 1,
      "change": "Use one consistent risk criterion for accept, counter and walk, and evaluate the uncertain difference between actions. Add a two-step negotiation lookahead.",
      "why": "Avoid premature acceptance and distinguish temporary disagreement from a lost deal.",
      "initial_parameters": {
        "lookahead_depth": 2,
        "supplier_scenarios": 64,
        "shortlisted_packages_per_step": 6
      },
      "validation": "Saved-opening and simulator sensitivity checks before any additional hosted sessions. Do not force a counter if acceptance really dominates."
    },
    {
      "priority": 2,
      "change": "Represent sourced conditional preferences and coupled terms: index clause x duration; quality x price/chargeback; volume x duration/capacity.",
      "why": "A supplier condition must change package ranking rather than disappear into prose.",
      "validation": "Use P08/P18 replay cases to verify that an explicit index condition changes the next candidate set. Claimed supplier conditions remain uncertain, not buyer hard constraints."
    },
    {
      "priority": 3,
      "change": "Update beliefs using counteroffer terms and movement, with cautious likelihoods and uncertainty; add a consistency check for production-cost estimates.",
      "why": "A simple accept/counter label throws away the strongest numeric information. Supplier counteroffers are strategic demands, not ground-truth reservation prices.",
      "validation": "Assess prediction error and decision regret separately; keep buyer cost rates from the case and learn unknown supplier preferences."
    },
    {
      "priority": 4,
      "change": "Add an independent decision critic using the already configured large Qwen model, after Python has ranked packages.",
      "why": "Current large-model escalation only resolves source ambiguity; it does not audit the proposed deal.",
      "critic_input": [
        "source evidence and full current supplier conditions",
        "allowed and fixed terms",
        "top six packages with cost breakdowns",
        "proposed action and available standing deal",
        "remaining moves and calibrated uncertainty"
      ],
      "critic_output": [
        "missed condition with exact supporting quote",
        "alternative permitted package",
        "suspect cost assumption or unsupported factual claim"
      ],
      "triggers": [
        "accepting before any negotiation",
        "unresolved condition contradicted by proposed package",
        "large concession or economically consequential uncertainty"
      ],
      "limits": "Separate prompt without the first model rationale to reduce anchoring. Python validates every suggestion and recomputes cost; the critic cannot bypass constraints or send an offer. Keep a strict time limit and safe fallback."
    },
    {
      "priority": 5,
      "change": "Compare structural changes through isolated offline ablations, then a bounded paired hosted test.",
      "why": "A bigger model benchmark is not evidence of better procurement deals. Keep old policy and replays, and report regressions and latency along with mean score."
